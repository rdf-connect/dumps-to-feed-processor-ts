@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

### Import the processor definitions
<> owl:imports <./node_modules/@rdfc/js-runner/index.ttl>.
<> owl:imports <./node_modules/@rdfc/file-utils-processors-ts/processors.ttl>.
<> owl:imports <./node_modules/@rdfc/shacl-processor-ts/processors.ttl>.
<> owl:imports <../processor.ttl>.

### Run the processors in the NodeRunner
<> a rdfc:Pipeline;
  rdfc:consistsOf [
    rdfc:instantiates rdfc:NodeRunner;
    rdfc:processor <reader>, <dumpsToFeed>, <validator>, <feedWriter>, <reportWriter>;
  ].

### Define the channels
<dump> a rdfc:Reader, rdfc:Writer.
<feed> a rdfc:Reader, rdfc:Writer.
<validated> a rdfc:Reader, rdfc:Writer.
<report> a rdfc:Reader, rdfc:Writer.

### Read the URL of the dump
<reader> a rdfc:GlobRead;
  rdfc:glob "sweden.url";
  rdfc:output <dump>.

### Convert the dump to a feed
<dumpsToFeed> a rdfcp:DumpsToFeed;
  rdfcp:input <dump>;
  rdfcp:output <feed>;
  rdfcp:feedname "sweden";
  rdfcp:flush false;
  rdfcp:dumpContentType "identifier";
  rdfcp:focusNodesStrategy "extract";
  rdfcp:nodeShapeIri "https://semiceu.github.io/LDES-DCAT-AP-feeds/shape.ttl#ActivityShape";
  rdfcp:dbDir <./>.

### Validate the feed against the DCAT-AP Feeds shape
<validator> a rdfc:Validate;
  rdfc:shaclPath "https://semiceu.github.io/LDES-DCAT-AP-feeds/shape.ttl#ActivityShape";
  rdfc:incoming <feed>;
  rdfc:outgoing <validated>;
  rdfc:report <report>;
  rdfc:validationIsFatal false;
  rdfc:mime "application/trig".

### Write the validated feed and the validation reports to files
<feedWriter> a rdfc:FileWriter;
  rdfc:input <validated>;
  rdfc:filePath "feed-validated.ttl".

<reportWriter> a rdfc:FileWriter;
  rdfc:input <report>;
  rdfc:filePath "report.ttl".
