@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

rdfc:DumpsToFeed a owl:Class, rdfs:Class;
  rdfc:jsImplementationOf rdfc:Processor;
  rdfs:label "Dumps To Feed Processor";
  rdfs:comment "A processor that converts a dump of RDF data to a feed of RDF data based on a member SHACL shape.";
  rdfc:file <./dist/index.js>;
  rdfc:class "DumpsToFeed";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfc:DumpsToFeed;
  sh:property [
    sh:class rdfc:Writer;
    sh:path rdfc:output;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:feedname;
    sh:codeIdentifier "feedname";
    sh:name "Feed name";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:boolean;
    sh:path rdfc:flush;
    sh:codeIdentifier "flush";
    sh:name "Flush";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:class rdfc:Reader;
    sh:path rdfc:dump;
    sh:codeIdentifier "dump";
    sh:name "Input channel";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:boolean;
    sh:path rdfc:readAsStream;
    sh:codeIdentifier "readAsStream";
    sh:name "Read as stream";
    sh:defaultValue false;
    sh:maxCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:dumpContentType;
    sh:codeIdentifier "dumpContentType";
    sh:name "Dump content type";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:focusNodesStrategy;
    sh:codeIdentifier "focusNodesStrategy";
    sh:name "Focus nodes strategy";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:nodeShapeIri;
    sh:codeIdentifier "nodeShapeIri";
    sh:name "Node shape IRI";
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:class rdfc:Reader;
    sh:path rdfc:nodeShape;
    sh:codeIdentifier "nodeShape";
    sh:name "Node shape channel";
    sh:maxCount 1;
  ], [
    sh:class rdfc:Reader;
    sh:path rdfc:focusNodes;
    sh:codeIdentifier "focusNodes";
    sh:name "Focus nodes channel";
    sh:maxCount 1;
  ], [
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:path rdfc:dbDir;
    sh:codeIdentifier "dbDir";
    sh:name "Database directory";
    sh:defaultValue "./";
    sh:maxCount 1;
  ].

